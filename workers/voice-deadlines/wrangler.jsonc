{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobhackai-voice-deadlines",
  "account_id": "fabf4409ef32f8c64354a1a099bef2a2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["VoiceDeadline"]}],
  "durable_objects": {"bindings": [{"name": "VOICE_DEADLINES", "class_name": "VoiceDeadline"}]},
  "vars": {"ENVIRONMENT": "local", "VOICE_DEADLINES_ENABLED": "false"},
  "env": {
    "dev": {
      "name": "jobhackai-voice-deadlines-dev",
      "vars": {"ENVIRONMENT": "dev", "VOICE_DEADLINES_ENABLED": "false"},
      "secrets": {"required": ["OPENAI_API_KEY"]},
      "d1_databases": [{"binding": "DB", "database_name": "jobhackai-dev-db", "database_id": "c5c0eee5-a223-4ea2-974e-f4aee5a28bab"}],
      "durable_objects": {"bindings": [{"name": "VOICE_DEADLINES", "class_name": "VoiceDeadline"}]}
    },
    "qa": {
      "name": "jobhackai-voice-deadlines-qa",
      "vars": {"ENVIRONMENT": "qa", "VOICE_DEADLINES_ENABLED": "false"},
      "secrets": {"required": ["OPENAI_API_KEY"]},
      "d1_databases": [{"binding": "DB", "database_name": "jobhackai-qa-db", "database_id": "80d87a73-6615-4823-b7a4-19a8821b4f87"}],
      "durable_objects": {"bindings": [{"name": "VOICE_DEADLINES", "class_name": "VoiceDeadline"}]}
    }
  }
}
