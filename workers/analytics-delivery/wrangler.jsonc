{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobhackai-analytics-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "env": {
    "dev": {
      "name": "jobhackai-analytics-delivery-dev",
      "vars": {"ENVIRONMENT": "dev", "DELIVERY_ENABLED": "false", "GA4_MEASUREMENT_ID": "", "DEBUG_EVENTS": "false"},
      "d1_databases": [{"binding": "DB", "database_name": "jobhackai-dev-db", "database_id": "c5c0eee5-a223-4ea2-974e-f4aee5a28bab"}],
      "triggers": {"crons": ["*/5 * * * *"]}
    },
    "qa": {
      "name": "jobhackai-analytics-delivery-qa",
      "vars": {"ENVIRONMENT": "qa", "DELIVERY_ENABLED": "false", "GA4_MEASUREMENT_ID": "G-VH888WWY3M", "DEBUG_EVENTS": "true"},
      "secrets": {"required": ["GA4_API_SECRET"]},
      "d1_databases": [{"binding": "DB", "database_name": "jobhackai-qa-db", "database_id": "80d87a73-6615-4823-b7a4-19a8821b4f87"}],
      "triggers": {"crons": ["*/5 * * * *"]}
    }
  }
}
