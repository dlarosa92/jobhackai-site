{
  "name": "jobhackai-app",
  "version": "1.0.0",
  "description": "JobHackAI Cloudflare Application",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "postbuild": "cp -f public/_redirects out/_redirects && cp -f public/_headers out/_headers && find .. -maxdepth 1 -type f -name '*.html' ! -name 'index.html' -exec cp -f {} out/ \\; && cp -r ../css out/ && cp -r ../js out/ && cp -r ../assets out/",
    "start": "next start",
    "export": "next build && next export",
    "deploy": "wrangler pages deploy out",
    "deploy:qa": "wrangler pages deploy out --project-name=jobhackai-app-qa --branch develop",
    "deploy:prod": "wrangler pages deploy out --branch main",
    "test:e2e": "playwright test --config tests/playwright.config.js",
    "test:e2e:dev": "cross-env TEST_ENV=dev playwright test --config tests/playwright.config.js",
    "test:e2e:qa": "cross-env TEST_ENV=qa playwright test --config tests/playwright.config.js",
    "test:e2e:prod": "cross-env TEST_ENV=prod playwright test --config tests/playwright.config.js",
    "test:e2e:full-app-check": "playwright test --config tests/playwright.config.js tests/e2e/full-app-check.spec.js",
    "test:e2e:full-app-check:dev": "cross-env TEST_ENV=dev playwright test --config tests/playwright.config.js tests/e2e/full-app-check.spec.js",
    "test:e2e:full-app-check:qa": "cross-env TEST_ENV=qa playwright test --config tests/playwright.config.js tests/e2e/full-app-check.spec.js",
    "test:e2e:full-app-check:prod": "cross-env TEST_ENV=prod playwright test --config tests/playwright.config.js tests/e2e/full-app-check.spec.js",
    "test:ats": "node functions/_lib/__tests__/ats-test-suite.test.mjs",
    "test:ats:verbose": "node functions/_lib/__tests__/ats-test-suite.test.mjs --verbose",
    "test:ats-engine": "node functions/_lib/__tests__/ats-scoring-engine.test.mjs",
    "test:grammar": "node functions/_lib/__tests__/grammar-engine.test.mjs",
    "test:voice:transcripts:smoke": "node tests/voice-transcripts/run-evals.mjs --mode smoke",
    "test:voice:transcripts:full": "node tests/voice-transcripts/run-evals.mjs --mode full",
    "test:voice:transcripts:stability": "node tests/voice-transcripts/run-evals.mjs --mode stability",
    "test:voice:transcripts:unit": "node tests/voice-transcripts/unit.test.mjs",
    "test:voice:interviewer": "node functions/_lib/__tests__/voice-interviewer.test.mjs",
    "test:voice:transcript-order": "node functions/_lib/__tests__/voice-transcript-order.test.mjs",
    "test:voice:entitlements": "node functions/_lib/__tests__/voice-entitlements.test.mjs",
    "test:voice:lifecycle": "node functions/_lib/__tests__/voice-lifecycle.test.mjs",
    "test:voice:conduct": "node functions/_lib/__tests__/voice-conduct.test.mjs",
    "test:voice:client": "node functions/_lib/__tests__/voice-client.test.mjs",
    "test:voice:history": "node functions/_lib/__tests__/voice-history.test.mjs",
    "test:voice": "npm run test:voice:entitlements && npm run test:voice:lifecycle && npm run test:voice:conduct && npm run test:voice:interviewer && npm run test:voice:client && npm run test:voice:history && npm run test:voice:transcript-order && npm run test:voice:transcripts:unit",
    "test:billing": "npm run test:billing:env && npm run test:billing:period && npm run test:billing:identity && npm run test:billing:db && npm run test:billing:mode-gate && npm run test:billing:webhook && npm run test:billing:trial && npm run test:billing:reconcile && npm run test:billing:guards && npm run test:billing:pack && npm run test:billing:voice-plans && npm run test:billing:reconcile-voice && npm run test:billing:env-gate && npm run test:billing:cli-guards && npm run test:billing:fulfilment && npm run test:billing:cutover && npm run test:billing:drift",
    "test:billing:guards": "node functions/_lib/__tests__/billing-endpoint-guards.test.mjs",
    "test:billing:env": "node functions/_lib/__tests__/stripe-environment.test.mjs",
    "test:billing:period": "node functions/_lib/__tests__/subscription-period.test.mjs",
    "test:billing:identity": "node functions/_lib/__tests__/stripe-identity.test.mjs",
    "test:billing:db": "node functions/_lib/__tests__/update-user-plan-period.test.mjs",
    "test:billing:mode-gate": "node functions/_lib/__tests__/stripe-webhook-mode-gate.test.mjs",
    "test:billing:webhook": "node functions/_lib/__tests__/stripe-webhook-identity.test.mjs",
    "test:billing:trial": "node functions/_lib/__tests__/trial-conversion.test.mjs",
    "test:billing:reconcile": "node functions/_lib/__tests__/billing-reconcile.test.mjs",
    "test:billing:pack": "node functions/_lib/__tests__/stripe-webhook-pack.test.mjs",
    "test:billing:voice-plans": "node functions/_lib/__tests__/stripe-webhook-voice-plans.test.mjs",
    "test:billing:reconcile-voice": "node functions/_lib/__tests__/billing-reconcile-voice.test.mjs",
    "test:billing:env-gate": "node functions/_lib/__tests__/stripe-webhook-environment-gate.test.mjs",
    "test:billing:cli-guards": "node functions/_lib/__tests__/billing-reconcile-guards.test.mjs",
    "test:billing:fulfilment": "node functions/_lib/__tests__/stripe-webhook-fulfilment.test.mjs",
    "test:billing:migrations": "bash ../scripts/verify-billing-migrations.sh",
    "test:billing:cutover": "node functions/_lib/__tests__/dev-cutover.test.mjs",
    "test:billing:drift": "node functions/_lib/__tests__/billing-reconcile-drift.test.mjs"
  },
  "dependencies": {
    "firebase": "^10.7.0",
    "jose": "^5.0.0",
    "mammoth": "^1.6.0",
    "next": "^14.0.0",
    "openai": "^4.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
