# Handle client-side routing for Next.js static export
/dashboard/   /dashboard/index.html    200
/dashboard-simple/   /dashboard-simple/index.html    200

# Stripe checkout redirects (preserve query params)
# NOTE: /pricing is served by functions/pricing.js (which subrequests
# /pricing.html via next()), and /pricing-a by functions/pricing-a.js (301 to
# /pricing). Do NOT add redirect rules for /pricing, /pricing.html, /pricing-a,
# or /pricing-a.html here: a rule on /pricing.html turns the function's internal
# next() fetch into a 301 and creates an infinite redirect loop. Duplicate-content
# for the .html URLs is handled by the canonical tag in pricing.html.

# Auth routes - Firebase sends /auth/action but Cloudflare needs /auth/action/
/auth/action   /auth/action/index.html   200
/auth/action/   /auth/action/index.html   200

# App root should go to the real login flow, not the legacy landing page
/   /login   302
/index.html   /login   301

# Redirect deleted pages to account settings
/add-card   /account-setting.html   301
/add-card.html   /account-setting.html   301
/billing-management   /account-setting.html   301
/billing-management.html   /account-setting.html   301

# Fallback for all other routes
/*    /index.html   200
